# =====================================================================
# Section 2 — Pest service URL restructuring
# Old: /pest-solutions/{pest-slug}   →   New: /{pest-slug}
#
# Specific overrides first, then splat catches the 15 remaining pest slugs.
# Splat with-slash form uses trailing-slash target so the user lands on the
# canonical route in one hop; no-slash form falls through to the same splat
# and Next.js does its own 308 to the canonical (two-hop, unavoidable when
# collapsing 32 individual rules into a splat).
# =====================================================================

# Renamed: /pest-solutions/rodent-removal → /rodent-control-melbourne
/pest-solutions/rodent-removal/                        /rodent-control-melbourne/              301
/pest-solutions/rodent-removal                         /rodent-control-melbourne/              301

# Removed pest pages — redirect to closest equivalent (must precede splat)
/pest-solutions/birds-control-melbourne/               /pest-solutions/                        301
/pest-solutions/birds-control-melbourne                /pest-solutions/                        301
/birds-control-melbourne/                              /pest-solutions/                        301
/birds-control-melbourne                               /pest-solutions/                        301

# Explicit keep-as-is guards for pages that live under /pest-solutions/ on
# the new site (seasonal / organic / garden) AND the /pest-solutions/ hub
# root itself. Two rules per page:
#   - trailing-slash form: 200 rewrite so CF serves the static page and does
#     not fall through to the splat below.
#   - no-slash form: 301 to the trailing-slash canonical (would otherwise hit
#     the splat and 301 to a 404 at /{slug}).
#
# ROOT GUARD: the splat `/pest-solutions/*` matches `/pest-solutions/` too
# with an empty splat capture, so without the explicit /pest-solutions/ rule
# below the hub page 301s to `/` (site root). Regression Zaydan would catch
# on his 426-URL sweep — do NOT remove.
/pest-solutions/                                       /pest-solutions/                                        200
/pest-solutions                                        /pest-solutions/                                        301
/pest-solutions/seasonal-pest-control/                 /pest-solutions/seasonal-pest-control/                  200
/pest-solutions/seasonal-pest-control                  /pest-solutions/seasonal-pest-control/                  301
/pest-solutions/organic-pest-control/                  /pest-solutions/organic-pest-control/                   200
/pest-solutions/organic-pest-control                   /pest-solutions/organic-pest-control/                   301
/pest-solutions/garden-pest-control/                   /pest-solutions/garden-pest-control/                    200
/pest-solutions/garden-pest-control                    /pest-solutions/garden-pest-control/                    301

# Splat: any remaining /pest-solutions/{slug} → /{slug}
# Handles all 15 canonical pest slugs (ant, bed-bug, bee, clothes-moths,
# cockroach, flea, fly, mosquito, possum, silverfish, spider, termite,
# treatment-for-wood-borers, wasp) plus any legacy URL we haven't listed.
/pest-solutions/*                                      /:splat                                 301

