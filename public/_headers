# Security + Cache headers for the site.
#
# This file works on both Cloudflare Pages and Netlify — both platforms read
# `_headers` from the publish directory root. Netlify additionally reads
# `netlify.toml` [[headers]], and where the two overlap this file's rules
# take precedence in Netlify. Keeping the same rules in both files means the
# site behaves identically wherever it is deployed.
#
# Docs:
# - https://developers.cloudflare.com/pages/configuration/headers/
# - https://docs.netlify.com/routing/headers/

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-DNS-Prefetch-Control: on
  # HSTS — Netlify injected this at the edge automatically; Cloudflare Pages
  # does NOT. Declaring it here keeps the header live across both hosts.
  # 1 year, include subdomains. NO `preload` directive per Zaydan's 2026-09-08
  # ask: preload signals intent to submit to hstspreload.org; if anyone ever
  # submits, browsers pin HTTPS-only for a year regardless of DNS state, which
  # kills our ability to roll back to HTTP if needed. Add `preload` back only
  # after site is stable and Zap It explicitly opts into the preload list.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# ─────────────────────────────────────────────────────────────────────────────
# Cache-Control rules
#
# Before this file was added, Cloudflare Pages served every asset with
# `cache-control: public, max-age=0, must-revalidate` and `cf-cache-status:
# DYNAMIC`, which meant zero edge caching — TTFB ran ~4.4 seconds against a
# baseline of <500ms for a properly cached static site. These rules move the
# site to standard static-hosting cache behaviour.
#
# Strategy:
# - Hashed Next.js chunks → cache forever (filename changes when content does)
# - Images → cache 1 week (content stable, no filename hash)
# - Fonts → cache 1 year, immutable
# - Sitemap/robots → cache 1 hour at edge (changes when pages added)
# - HTML pages → stay short (no s-maxage override) so Cloudflare Pages'
#   automatic cache-purge on deploy keeps HTML always fresh across edges.
#   HTML wins its performance back via the asset-cache rules below (every
#   page's JS/CSS/images now return in <50ms edge-cached instead of 4s origin).

# Next.js hashed static assets — safe to cache forever (filename hashes change on content change)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images — cache 1 week
/images/*
  Cache-Control: public, max-age=604800

# Favicon — cache 1 day
/favicon.ico
  Cache-Control: public, max-age=86400

# Fonts — immutable, cache 1 year
*.woff2
  Cache-Control: public, max-age=31536000, immutable
*.woff
  Cache-Control: public, max-age=31536000, immutable
*.ttf
  Cache-Control: public, max-age=31536000, immutable

# Sitemap + robots — short cache so new pages surface quickly
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600

